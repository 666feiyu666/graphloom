# Graphloom local runtime configuration. Copy to .env only if you need overrides.
GRAPPHLOOM_DB_PATH=.local/graphloom.db
GRAPPHLOOM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GRAPPHLOOM_MAX_BODY_BYTES=10485760
GRAPPHLOOM_RATE_LIMIT_PER_MINUTE=1200
GRAPPHLOOM_FRONTEND_DIST=frontend/dist
